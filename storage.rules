rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Media Post Storage: /posts/{postId}/{type}/{fileName}
    match /posts/{postId}/{mediaType}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && (
                     (mediaType == 'images' && request.resource.size <= 10 * 1024 * 1024 && request.resource.contentType.matches('image/.*')) ||
                     (mediaType == 'videos' && request.resource.size <= 100 * 1024 * 1024 && request.resource.contentType.matches('video/.*'))
                   );
    }
  }
}
